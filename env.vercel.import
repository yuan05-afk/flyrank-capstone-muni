# DATABASE_URL - Neon pooled Postgres URL (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# DEMO_API_KEY - owner desk sign-in (change in production)
DEMO_API_KEY=muni_demo_key_001

# Fill after first deploy of each Capstone (then redeploy Muni)
NEXT_PUBLIC_APP_URL=https://muni-flyrank.vercel.app
NEXT_PUBLIC_CAPSTONE_CHECKPOINT_URL=https://checkpoint-flyrank.vercel.app
NEXT_PUBLIC_CAPSTONE_LENS_URL=https://lens-flyrank.vercel.app
NEXT_PUBLIC_CAPSTONE_BROADCAST_URL=https://broadcast-flyrank.vercel.app

# seed = free deterministic demo. Optional: CHAT_PROVIDER=groq + GROQ_API_KEY
CHAT_PROVIDER=seed
EMBEDDING_PROVIDER=seed
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

SIM_THRESHOLD=0.42
CONF_THRESHOLD=0.72
MAX_BATCH_USD=2.5
JOB_LEASE_MS=30000
JOB_MAX_ATTEMPTS=3
