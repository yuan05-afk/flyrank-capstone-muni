generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model KnowledgeCard {
  id        String   @id @default(cuid())
  kind      String
  title     String
  body      String
  sourceId  String?
  tagsJson  String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  embedding Embedding? @relation("CardEmbedding")

  @@index([kind])
}

model Embedding {
  id         String         @id @default(cuid())
  ownerType  String
  ownerId    String         @unique
  model      String
  dims       Int
  vectorJson String
  updatedAt  DateTime       @updatedAt
  card       KnowledgeCard? @relation("CardEmbedding", fields: [cardId], references: [id], onDelete: Cascade)
  cardId     String?        @unique

  @@index([ownerType, ownerId])
}

model Conversation {
  id        String        @id @default(cuid())
  audience  String        @default("general")
  createdAt DateTime      @default(now())
  messages  Message[]
  answers   AgentAnswer[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AgentAnswer {
  id             String        @id @default(cuid())
  conversationId String?
  question       String
  answer         String
  citationsJson  String        @default("[]")
  grounded       Boolean       @default(false)
  status         String
  guardReason    String?
  confidence     Float
  policyId       String?
  featuresJson   String?
  createdAt      DateTime      @default(now())
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([policyId])
}

model Job {
  id             String    @id @default(cuid())
  type           String
  payload        String
  idempotencyKey String?   @unique
  runAt          DateTime  @default(now())
  attempts       Int       @default(0)
  lockedAt       DateTime?
  leaseUntil     DateTime?
  heartbeatAt    DateTime?
  doneAt         DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([runAt, doneAt, lockedAt])
  @@index([leaseUntil])
}

model CostEvent {
  id          String   @id @default(cuid())
  kind        String
  model       String
  units       Int
  unitCostUsd Float
  totalUsd    Float
  refType     String
  refId       String
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@index([refType, refId])
}
