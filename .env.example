# Local development must use a separate Neon development branch.
# Do not paste the production branch URL here: tests and evals write conversations and answers.
# Use the pooled branch URL, for example:
# postgresql://USER:PASSWORD@DEVELOPMENT-POOLER-HOST/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Demo session key (sign-in cookie value; set a long random value in production)
DEMO_API_KEY="muni_demo_key_001"

# Public URLs (fill after Vercel deploy; used for Capstone cross-links in a follow-up)
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_CAPSTONE_CHECKPOINT_URL=""
NEXT_PUBLIC_CAPSTONE_LENS_URL=""
NEXT_PUBLIC_CAPSTONE_BROADCAST_URL=""

# Production demo: seed providers ($0, deterministic). Optional live chat: groq + GROQ_API_KEY.
CHAT_PROVIDER="seed"
EMBEDDING_PROVIDER="seed"
GROQ_API_KEY=""
GROQ_CHAT_MODEL="llama-3.3-70b-versatile"
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-1.5-flash"
GEMINI_EMBED_MODEL="text-embedding-004"

# Matching and guard thresholds (defaults match graded eval)
SIM_THRESHOLD="0.42"
CONF_THRESHOLD="0.72"

# Batch spend cap and worker lease settings
MAX_BATCH_USD="2.5"
JOB_LEASE_MS="30000"
JOB_MAX_ATTEMPTS="3"
